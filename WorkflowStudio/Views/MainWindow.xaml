<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WorkflowStudio.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkflowStudio.Controls"
    xmlns:models="using:WorkflowStudio.Models"
    xmlns:vm="using:WorkflowStudio.ViewModels"
    Title="Workflow Studio (WinUI 3)">

    <!-- Native Windows 11 Mica backdrop automatically adapts to Light/Dark theme and desktop wallpaper -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Row 0: Menu Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Main Workbench (Left Pane + Workspace + Diagnostics) -->
            <RowDefinition Height="*" />
            <!-- Row 3: Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================================
             1. MENU BAR (File, Edit, View, Window, Help)
             ================================================================ -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <MenuBar Padding="4,0">
                <!-- FILE -->
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="New Project" Command="{x:Bind ViewModel.NewProjectCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A5;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="Load Sample Pipeline" Command="{x:Bind ViewModel.LoadStarterProjectCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8F1;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="Open Project..." Click="OnOpenProjectClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8E5;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Text="Save" Click="OnSaveProjectClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74E;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="Save As..." Click="OnSaveProjectAsClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE792;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Text="Exit" Click="OnExitClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>

                <!-- EDIT -->
                <MenuBarItem Title="Edit">
                    <MenuFlyoutSubItem Text="Add Component">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE710;" />
                        </MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem Text="Trigger Step" Command="{x:Bind ViewModel.AddStepCommand}" CommandParameter="Trigger" />
                        <MenuFlyoutItem Text="Build Step" Command="{x:Bind ViewModel.AddStepCommand}" CommandParameter="Build" />
                        <MenuFlyoutItem Text="Test Step" Command="{x:Bind ViewModel.AddStepCommand}" CommandParameter="Test" />
                        <MenuFlyoutItem Text="Script Step" Command="{x:Bind ViewModel.AddStepCommand}" CommandParameter="Script" />
                        <MenuFlyoutItem Text="Deploy Step" Command="{x:Bind ViewModel.AddStepCommand}" CommandParameter="Deploy" />
                        <MenuFlyoutItem Text="Notify Step" Command="{x:Bind ViewModel.AddStepCommand}" CommandParameter="Notify" />
                    </MenuFlyoutSubItem>

                    <MenuFlyoutItem Text="Duplicate Selected Step" Command="{x:Bind ViewModel.DuplicateSelectedStepCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="D" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="Delete Selected Step" Command="{x:Bind ViewModel.DeleteSelectedStepCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Text="Move Step Up" Command="{x:Bind ViewModel.MoveStepUpCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74A;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Up" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="Move Step Down" Command="{x:Bind ViewModel.MoveStepDownCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74B;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Down" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Text="Project Properties..." Click="OnProjectPropertiesClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>

                <!-- VIEW -->
                <MenuBarItem Title="View">
                    <ToggleMenuFlyoutItem
                        Text="Left Explorer Pane"
                        IsChecked="{x:Bind ViewModel.IsLeftPaneVisible, Mode=TwoWay}">
                        <ToggleMenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="B" Modifiers="Control" />
                        </ToggleMenuFlyoutItem.KeyboardAccelerators>
                    </ToggleMenuFlyoutItem>

                    <ToggleMenuFlyoutItem
                        Text="Diagnostics Pane"
                        IsChecked="{x:Bind ViewModel.IsDiagnosticsPaneVisible, Mode=TwoWay}">
                        <ToggleMenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="J" Modifiers="Control" />
                        </ToggleMenuFlyoutItem.KeyboardAccelerators>
                    </ToggleMenuFlyoutItem>

                    <ToggleMenuFlyoutItem
                        Text="Toolbar"
                        IsChecked="{x:Bind ViewModel.IsToolbarVisible, Mode=TwoWay}" />

                    <ToggleMenuFlyoutItem
                        Text="Status Bar"
                        IsChecked="{x:Bind ViewModel.IsStatusBarVisible, Mode=TwoWay}" />

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Text="Run Workflow" Command="{x:Bind ViewModel.RunWorkflowCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="Stop Workflow" Command="{x:Bind ViewModel.StopWorkflowCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE71A;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" Modifiers="Shift" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="Validate Workflow" Command="{x:Bind ViewModel.ValidateWorkflowCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE73E;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="B" Modifiers="Control,Shift" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutSubItem Text="App Theme">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE790;" />
                        </MenuFlyoutSubItem.Icon>
                        <RadioMenuFlyoutItem
                            Text="Use System Theme"
                            GroupName="AppTheme"
                            IsChecked="True"
                            Tag="Default"
                            Click="OnThemeRadioClick" />
                        <RadioMenuFlyoutItem
                            Text="Light"
                            GroupName="AppTheme"
                            Tag="Light"
                            Click="OnThemeRadioClick" />
                        <RadioMenuFlyoutItem
                            Text="Dark"
                            GroupName="AppTheme"
                            Tag="Dark"
                            Click="OnThemeRadioClick" />
                    </MenuFlyoutSubItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Text="Reset Layout" Command="{x:Bind ViewModel.ResetLayoutCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>

                <!-- WINDOW -->
                <MenuBarItem Title="Window">
                    <MenuFlyoutItem Text="New Window" Click="OnNewWindowClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control,Shift" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>

                    <ToggleMenuFlyoutItem
                        x:Name="AlwaysOnTopMenuItem"
                        Text="Always on Top"
                        Click="OnAlwaysOnTopClick" />

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Text="Close Current Tab" Command="{x:Bind ViewModel.CloseCurrentTabCommand}">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="W" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="Close All Tabs" Command="{x:Bind ViewModel.CloseAllTabsCommand}" />
                </MenuBarItem>

                <!-- HELP -->
                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="WinUI 3 Architecture Guide" Click="OnArchitectureGuideClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE82D;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="Keyboard Shortcuts" Click="OnShortcutsClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE765;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Text="About Workflow Studio" Click="OnAboutClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>
            </MenuBar>
        </Border>

        <!-- ================================================================
             2. TOOLBAR
             ================================================================ -->
        <Border
            Grid.Row="1"
            Padding="8,5"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Visibility="{x:Bind BoolToVis(ViewModel.IsToolbarVisible), Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <!-- File actions -->
                    <Button
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Bind ViewModel.NewProjectCommand}"
                        ToolTipService.ToolTip="New Project (Ctrl+N)">
                        <FontIcon Glyph="&#xE8A5;" FontSize="15" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnOpenProjectClick"
                        ToolTipService.ToolTip="Open Project (Ctrl+O)">
                        <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnSaveProjectClick"
                        ToolTipService.ToolTip="Save Project (Ctrl+S)">
                        <FontIcon Glyph="&#xE74E;" FontSize="15" />
                    </Button>

                    <Border Width="1" Height="20" Margin="4,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Component management -->
                    <DropDownButton Padding="8,5" MinHeight="30" ToolTipService.ToolTip="Add a new workflow component">
                        <DropDownButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="Add Step" FontSize="13" />
                            </StackPanel>
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Text="Trigger" Command="{x:Bind ViewModel.AddStepCommand}" CommandParameter="Trigger">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE945;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Build" Command="{x:Bind ViewModel.AddStepCommand}" CommandParameter="Build">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE90F;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Test" Command="{x:Bind ViewModel.AddStepCommand}" CommandParameter="Test">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Script" Command="{x:Bind ViewModel.AddStepCommand}" CommandParameter="Script">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Deploy" Command="{x:Bind ViewModel.AddStepCommand}" CommandParameter="Deploy">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE898;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Notify" Command="{x:Bind ViewModel.AddStepCommand}" CommandParameter="Notify">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA8F;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Bind ViewModel.DuplicateSelectedStepCommand}"
                        ToolTipService.ToolTip="Duplicate Selected Step (Ctrl+D)">
                        <FontIcon Glyph="&#xE8C8;" FontSize="15" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Bind ViewModel.DeleteSelectedStepCommand}"
                        ToolTipService.ToolTip="Delete Selected Step">
                        <FontIcon Glyph="&#xE74D;" FontSize="15" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Bind ViewModel.MoveStepUpCommand}"
                        ToolTipService.ToolTip="Move Step Up (Alt+Up)">
                        <FontIcon Glyph="&#xE74A;" FontSize="14" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Bind ViewModel.MoveStepDownCommand}"
                        ToolTipService.ToolTip="Move Step Down (Alt+Down)">
                        <FontIcon Glyph="&#xE74B;" FontSize="14" />
                    </Button>

                    <Border Width="1" Height="20" Margin="4,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Execution controls -->
                    <Button
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="12,5"
                        MinHeight="30"
                        Command="{x:Bind ViewModel.RunWorkflowCommand}"
                        ToolTipService.ToolTip="Run All Enabled Steps (F5)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                            <TextBlock Text="Run Workflow" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Bind ViewModel.StopWorkflowCommand}"
                        ToolTipService.ToolTip="Stop Execution (Shift+F5)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71A;" FontSize="13" />
                            <TextBlock Text="Stop" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <Button
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Bind ViewModel.ValidateWorkflowCommand}"
                        ToolTipService.ToolTip="Validate Workflow Configuration (Ctrl+Shift+B)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                            <TextBlock Text="Validate" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <ProgressRing
                        Width="18"
                        Height="18"
                        Margin="6,0,0,0"
                        IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                        Visibility="{x:Bind BoolToVis(ViewModel.IsRunning), Mode=OneWay}" />
                </StackPanel>

                <!-- Quick layout pane toggles -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <ToggleButton
                        Padding="8,5"
                        MinHeight="30"
                        IsChecked="{x:Bind ViewModel.IsLeftPaneVisible, Mode=TwoWay}"
                        ToolTipService.ToolTip="Toggle Left Explorer Pane (Ctrl+B)">
                        <FontIcon Glyph="&#xE8A0;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton
                        Padding="8,5"
                        MinHeight="30"
                        IsChecked="{x:Bind ViewModel.IsDiagnosticsPaneVisible, Mode=TwoWay}"
                        ToolTipService.ToolTip="Toggle Diagnostics Pane (Ctrl+J)">
                        <FontIcon Glyph="&#xE9D2;" FontSize="14" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================
             3. MAIN WORKBENCH AREA
             Left Explorer Pane | Vertical Splitter | (Workspace / Horizontal Splitter / Diagnostics)
             ================================================================ -->
        <Grid x:Name="WorkbenchGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneColumn" Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: Project Components Explorer -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{x:Bind BoolToVis(ViewModel.IsLeftPaneVisible), Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Pane Header -->
                    <Grid Grid.Row="0" Padding="12,8,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="COMPONENTS" Style="{StaticResource PaneHeaderTextStyle}" />
                            <Border
                                Padding="6,1"
                                CornerRadius="10"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.TotalStepCount, Mode=OneWay}"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <Button
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="6,4"
                                Command="{x:Bind ViewModel.AddStepCommand}"
                                CommandParameter="Script"
                                ToolTipService.ToolTip="Quick Add Script Step">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                            </Button>
                            <Button
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="6,4"
                                Click="OnHideLeftPaneClick"
                                ToolTipService.ToolTip="Collapse Left Pane">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Component Search Filter -->
                    <TextBox
                        Grid.Row="1"
                        Margin="10,0,10,8"
                        PlaceholderText="Filter steps..."
                        Text="{x:Bind ViewModel.StepSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Components ListView -->
                    <ListView
                        x:Name="StepsListView"
                        Grid.Row="2"
                        Padding="4,0,4,8"
                        SelectionMode="Single"
                        ItemsSource="{x:Bind ViewModel.FilteredSteps}"
                        SelectedItem="{x:Bind ViewModel.SelectedStep, Mode=OneWay}"
                        SelectionChanged="OnStepsListSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkflowStepViewModel">
                                <Grid
                                    Padding="4,6"
                                    Opacity="{x:Bind ItemOpacity, Mode=OneWay}"
                                    Background="Transparent">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Run This Step" Click="OnContextRunStepClick" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Duplicate" Click="OnContextDuplicateStepClick" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Delete" Click="OnContextDeleteStepClick" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Category icon -->
                                    <Border
                                        Grid.Column="0"
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,10,0"
                                        CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <FontIcon Glyph="{x:Bind TypeGlyph, Mode=OneWay}" FontSize="14" />
                                    </Border>

                                    <!-- Name & type/status subtitle -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                Text="{x:Bind TypeLabel, Mode=OneWay}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="•"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind StatusText, Mode=OneWay}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Live status dot -->
                                    <Ellipse
                                        Grid.Column="2"
                                        Width="8"
                                        Height="8"
                                        Margin="8,0,2,0"
                                        VerticalAlignment="Center"
                                        Fill="{x:Bind StatusBrush, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- VERTICAL RESIZE SPLITTER -->
            <controls:PaneSplitter
                x:Name="LeftSplitter"
                Grid.Column="1"
                Orientation="Vertical"
                DragDelta="OnLeftSplitterDragDelta"
                Visibility="{x:Bind BoolToVis(ViewModel.IsLeftPaneVisible), Mode=OneWay}" />

            <!-- RIGHT SIDE: Middle Workspace (top) + Bottom Diagnostics Pane (bottom) -->
            <Grid x:Name="RightAreaGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="DiagnosticsRow" Height="210" />
                </Grid.RowDefinitions>

                <!-- MIDDLE: Tabbed Project Workspace -->
                <Grid Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <TabView
                        x:Name="WorkspaceTabView"
                        IsAddTabButtonVisible="True"
                        TabWidthMode="SizeToContent"
                        TabItemsSource="{x:Bind ViewModel.OpenTabs}"
                        SelectedItem="{x:Bind ViewModel.SelectedStep, Mode=OneWay}"
                        SelectionChanged="OnWorkspaceTabSelectionChanged"
                        AddTabButtonClick="OnAddTabButtonClick"
                        TabCloseRequested="OnWorkspaceTabCloseRequested"
                        Visibility="{x:Bind BoolToVis(ViewModel.HasOpenTabs), Mode=OneWay}">
                        <TabView.TabItemTemplate>
                            <DataTemplate x:DataType="vm:WorkflowStepViewModel">
                                <TabViewItem>
                                    <TabViewItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind TypeGlyph, Mode=OneWay}" FontSize="13" />
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                            <Ellipse Width="7" Height="7" Fill="{x:Bind StatusBrush, Mode=OneWay}" />
                                        </StackPanel>
                                    </TabViewItem.Header>

                                    <!-- Step Editor Content inside Tab -->
                                    <ScrollViewer Padding="24,18" VerticalScrollBarVisibility="Auto">
                                        <StackPanel MaxWidth="860" HorizontalAlignment="Left" Spacing="16">

                                            <!-- Header banner for active component -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                    <Border
                                                        Width="40"
                                                        Height="40"
                                                        CornerRadius="8"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                        <FontIcon Glyph="{x:Bind TypeGlyph, Mode=OneWay}" FontSize="20" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock
                                                            Text="{x:Bind Name, Mode=OneWay}"
                                                            Style="{StaticResource SubtitleTextBlockStyle}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Border
                                                                Padding="8,2"
                                                                CornerRadius="10"
                                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Ellipse Width="7" Height="7" Fill="{x:Bind StatusBrush, Mode=OneWay}" />
                                                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" />
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock
                                                                Text="{x:Bind TypeLabel, Mode=OneWay}"
                                                                FontSize="12"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                    <ToggleSwitch
                                                        OnContent="Enabled"
                                                        OffContent="Disabled"
                                                        MinWidth="0"
                                                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                                    <Button
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        Click="OnRunThisStepClick"
                                                        Tag="{x:Bind}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                                                            <TextBlock Text="Run This Step" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- General Configuration Card -->
                                            <Border Style="{StaticResource SectionCardStyle}">
                                                <StackPanel Spacing="14">
                                                    <TextBlock Text="Step Configuration" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                                    <Grid ColumnSpacing="14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="150" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox
                                                            Grid.Column="0"
                                                            Header="Step Name"
                                                            PlaceholderText="Enter step name..."
                                                            Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                        <ComboBox
                                                            Grid.Column="1"
                                                            Header="Component Type"
                                                            HorizontalAlignment="Stretch"
                                                            ItemsSource="{x:Bind vm:WorkflowStepViewModel.AvailableStepTypes}"
                                                            SelectedIndex="{x:Bind StepTypeIndex, Mode=TwoWay}" />

                                                        <NumberBox
                                                            Grid.Column="2"
                                                            Header="Timeout (sec)"
                                                            Minimum="1"
                                                            Maximum="3600"
                                                            SpinButtonPlacementMode="Compact"
                                                            Value="{x:Bind TimeoutSeconds, Mode=TwoWay}" />
                                                    </Grid>

                                                    <TextBox
                                                        Header="Description"
                                                        PlaceholderText="What does this workflow step do?"
                                                        Text="{x:Bind Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBox
                                                        Header="Command / Action"
                                                        FontFamily="Cascadia Mono, Consolas"
                                                        AcceptsReturn="True"
                                                        TextWrapping="Wrap"
                                                        MinHeight="72"
                                                        PlaceholderText="Enter CLI command or script..."
                                                        Text="{x:Bind Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBox
                                                        Header="Working Directory"
                                                        FontFamily="Cascadia Mono, Consolas"
                                                        PlaceholderText="$(ProjectDir)"
                                                        Text="{x:Bind WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Execution & Demo Diagnostics Expander -->
                                            <Expander
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                                                        <TextBlock Text="Execution Behavior &amp; Diagnostic Simulation" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <Grid ColumnSpacing="24" RowSpacing="8" Padding="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <ToggleSwitch
                                                        Grid.Column="0"
                                                        Header="Continue on Error"
                                                        OnContent="Continue"
                                                        OffContent="Halt pipeline"
                                                        IsOn="{x:Bind ContinueOnError, Mode=TwoWay}" />

                                                    <ToggleSwitch
                                                        Grid.Column="1"
                                                        Header="Simulate Warning"
                                                        OnContent="Emit warning"
                                                        OffContent="Normal"
                                                        IsOn="{x:Bind SimulateWarning, Mode=TwoWay}" />

                                                    <ToggleSwitch
                                                        Grid.Column="2"
                                                        Header="Simulate Failure"
                                                        OnContent="Exit code 1"
                                                        OffContent="Normal"
                                                        IsOn="{x:Bind SimulateFailure, Mode=TwoWay}" />
                                                </Grid>
                                            </Expander>

                                            <!-- Live Step Output Preview Card -->
                                            <Border Style="{StaticResource SectionCardStyle}">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Last Step Output" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <Border
                                                        Padding="12"
                                                        CornerRadius="6"
                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                        <TextBlock
                                                            Text="{x:Bind DisplayOutput, Mode=OneWay}"
                                                            FontFamily="Cascadia Mono, Consolas"
                                                            FontSize="12"
                                                            TextWrapping="Wrap"
                                                            IsTextSelectionEnabled="True"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                        </StackPanel>
                                    </ScrollViewer>
                                </TabViewItem>
                            </DataTemplate>
                        </TabView.TabItemTemplate>
                    </TabView>

                    <!-- Empty workspace state when all tabs are closed -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind BoolToVis(ViewModel.HasNoOpenTabs), Mode=OneWay}">
                        <FontIcon Glyph="&#xE943;" FontSize="42" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="No Component Tabs Open"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Select a step from the left explorer pane, or create a new workflow component to start editing."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,4,0,0">
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.AddStepCommand}"
                                CommandParameter="Script"
                                Content="Add New Step" />
                            <Button
                                Command="{x:Bind ViewModel.RunWorkflowCommand}"
                                Content="Run Workflow (F5)" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- HORIZONTAL RESIZE SPLITTER -->
                <controls:PaneSplitter
                    x:Name="BottomSplitter"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    DragDelta="OnBottomSplitterDragDelta"
                    Visibility="{x:Bind BoolToVis(ViewModel.IsDiagnosticsPaneVisible), Mode=OneWay}" />

                <!-- BOTTOM PANE: Diagnostics & Live Execution Log -->
                <Border
                    Grid.Row="2"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{x:Bind BoolToVis(ViewModel.IsDiagnosticsPaneVisible), Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Diagnostics Header & Severity Filters -->
                        <Grid
                            Grid.Row="0"
                            Padding="12,5,8,5"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="DIAGNOSTICS" Style="{StaticResource PaneHeaderTextStyle}" Margin="0,0,6,0" />

                                <ToggleButton
                                    Padding="8,3"
                                    MinHeight="26"
                                    IsChecked="{x:Bind ViewModel.ShowErrorDiagnostics, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xEA39;" FontSize="12" Foreground="#FFE84A4A" />
                                        <TextBlock FontSize="12">
                                            <Run Text="Errors (" /><Run Text="{x:Bind ViewModel.ErrorCount, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </StackPanel>
                                </ToggleButton>

                                <ToggleButton
                                    Padding="8,3"
                                    MinHeight="26"
                                    IsChecked="{x:Bind ViewModel.ShowWarningDiagnostics, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="#FFE09F24" />
                                        <TextBlock FontSize="12">
                                            <Run Text="Warnings (" /><Run Text="{x:Bind ViewModel.WarningCount, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </StackPanel>
                                </ToggleButton>

                                <ToggleButton
                                    Padding="8,3"
                                    MinHeight="26"
                                    IsChecked="{x:Bind ViewModel.ShowInfoDiagnostics, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#FF3A96DD" />
                                        <TextBlock FontSize="12">
                                            <Run Text="Info (" /><Run Text="{x:Bind ViewModel.InfoCount, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox
                                    Width="180"
                                    Height="28"
                                    FontSize="12"
                                    PlaceholderText="Filter diagnostics..."
                                    Text="{x:Bind ViewModel.DiagnosticSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Padding="8,4"
                                    Command="{x:Bind ViewModel.ClearDiagnosticsCommand}"
                                    ToolTipService.ToolTip="Clear Diagnostics">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        <TextBlock Text="Clear" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Padding="6,4"
                                    Click="OnHideDiagnosticsPaneClick"
                                    ToolTipService.ToolTip="Hide Diagnostics Pane">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Diagnostics Log List -->
                        <ListView
                            x:Name="DiagnosticsListView"
                            Grid.Row="1"
                            Padding="4,2"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ItemClick="OnDiagnosticItemClick"
                            ItemsSource="{x:Bind ViewModel.FilteredDiagnostics}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="Padding" Value="8,2" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DiagnosticEntry">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            Glyph="{x:Bind IconGlyph}"
                                            Foreground="{x:Bind SeverityBrush}"
                                            FontSize="13"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind TimeText}"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind Source}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{x:Bind Message}"
                                            FontSize="12"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================================
             4. STATUS BAR (App state, run progress, diagnostics & metrics)
             ================================================================ -->
        <Border
            Grid.Row="3"
            Height="28"
            Padding="12,0"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind BoolToVis(ViewModel.IsStatusBarVisible), Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: App state & run progress -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.StatusIndicatorBrush, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ProgressBar
                        Width="120"
                        Minimum="0"
                        Maximum="100"
                        Value="{x:Bind ViewModel.RunProgress, Mode=OneWay}"
                        Visibility="{x:Bind BoolToVis(ViewModel.IsRunning), Mode=OneWay}" />
                </StackPanel>

                <!-- Right: Live counters & app metrics -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Clickable Errors/Warnings badge -->
                    <Button
                        Style="{StaticResource ToolbarButtonStyle}"
                        Padding="6,1"
                        MinHeight="22"
                        Click="OnShowDiagnosticsClick"
                        ToolTipService.ToolTip="Show Diagnostics Pane">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xEA39;" FontSize="11" Foreground="#FFE84A4A" />
                                <TextBlock Text="{x:Bind ViewModel.ErrorCount, Mode=OneWay}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="#FFE09F24" />
                                <TextBlock Text="{x:Bind ViewModel.WarningCount, Mode=OneWay}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="14" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock
                        Text="{x:Bind ViewModel.StepsSummaryText, Mode=OneWay}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Border Width="1" Height="14" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind ViewModel.ProjectFileLabel, Mode=OneWay}" />
                        <Run Text=" (" /><Run Text="{x:Bind ViewModel.UnsavedIndicator, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>

                    <Border Width="1" Height="14" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock
                        Text="{x:Bind ViewModel.MemoryUsageText, Mode=OneWay}"
                        FontSize="11"
                        FontFamily="Cascadia Mono, Consolas"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
